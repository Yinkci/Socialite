{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "socialite",
  "account_id": "085e65dd4910bfe4c621fe10c443ee1f",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Public address; the webhook is PUBLIC_URL/webhooks/facebook.
  // Page creation date supplied by the owner, bound to this Page ID.
  "vars": { "PUBLIC_URL": "https://socialite.wineandsilence.workers.dev", "CLOUDFLARE_ACCOUNT_ID": "085e65dd4910bfe4c621fe10c443ee1f", "PAGE_CREATED_ID": "1361648497024123", "PAGE_CREATED_AT": "2026-09-12T14:00:00+08:00" },
  // Dashboard files. Requests that are not files (/api, /webhooks) go to the Worker.
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "none" },
  // All app state (comments, settings, reply memory, secrets) lives in one SQLite-backed Durable Object.
  "durable_objects": { "bindings": [{ "name": "APP", "class_name": "SocialiteApp" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SocialiteApp"] }],
  // Watchdog that keeps the 15-second work loop scheduled.
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
